{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^mcp__[A-Za-z0-9_-]+__(?:[A-Za-z0-9_-]+_)?(?:ledger_(issue_save|spec_save|task_save|criterion_save|transition|record_deliverable|record_case|link|correct|batch|review|review_correct|whoami)|artifact_(begin|chunk|finish|status|read))$",
      "hooks": [{ "type": "command", "command": "java -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:-UsePerfData -Xlog:disable -jar \"${CLAUDE_PLUGIN_ROOT}/lib/ledger-client-hook.jar\" claude", "timeout": 10 }]
    }]
  }
}
